# Copy this file to .env and fill in whichever key(s) you're using.
# Never commit the real .env to git.

ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# For agent_github.py — the real GitHub connector.
# GITHUB_REPO is required, format "owner/repo", e.g. GITHUB_REPO=octocat/Hello-World
# GITHUB_TOKEN is optional for public repos (raises the rate limit from 60/hr to 5000/hr)
# and required for private repos. Create one at github.com/settings/tokens
# (classic token, "repo" scope, or fine-grained with Issues: Read-only).
GITHUB_REPO=
GITHUB_TOKEN=

# For agent_retail.py / retail_site.py — the real Shopify connector.
# SHOPIFY_STORE_URL, SHOPIFY_CLIENT_ID, and SHOPIFY_CLIENT_SECRET are all
# required. Shopify retired the old one-click "custom app, reveal a
# permanent token" flow for new apps, so this uses the client credentials
# grant instead (see connectors_retail.py's docstring for the full setup
# path via dev.shopify.com/dashboard). SHOPIFY_STORE_URL is your store's
# myshopify.com domain, e.g. SHOPIFY_STORE_URL=your-store.myshopify.com
# SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET come from an app's Settings
# tab at dev.shopify.com/dashboard after you create it, set Admin API
# scopes (needs at least read_orders and read_products), release it, and
# install it on your store. None of these three are your storefront API
# key or your Shopify account password.
SHOPIFY_STORE_URL=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional. Defaults to a recent stable version (see connectors_retail.py)
# — only set this if Shopify has retired the default and requests start
# failing with a 400 about an unsupported API version.
SHOPIFY_API_VERSION=
# Optional, defaults to 5. "Low stock" = at or below this many units,
# store-wide (Shopify doesn't have a native reorder-point field).
SHOPIFY_LOW_STOCK_THRESHOLD=

# For agent_healthcare.py / healthcare_site.py — the real Epic FHIR sandbox
# connector. This is Epic's OPEN, non-production sandbox with synthetic
# test patients only — never real patient data (PHI). See
# connectors_healthcare.py's docstring for the full setup path via
# fhir.epic.com (register a Backend Systems app, generate an RSA keypair,
# find a sandbox test patient's FHIR ID).
EPIC_CLIENT_ID=
EPIC_PRIVATE_KEY_PATH=
EPIC_TEST_PATIENT_IDS=
# Optional — defaults are Epic's standard open-sandbox R4 endpoints. Only
# set these if Epic has changed them (check fhir.epic.com/Documentation).
EPIC_FHIR_BASE_URL=
EPIC_TOKEN_URL=
# Optional, defaults to "system/Appointment.read" — must match whatever
# FHIR resource scope(s) you selected when registering the app.
EPIC_SCOPE=

# For agent_slack.py — the real Slack connector. NOTE: this connector has
# NO fabrication/content-verification guardrail wired in yet (deliberate,
# temporary — see agent_slack.py's module docstring for why and exactly
# what to add). Don't treat its output as trustworthy the way
# agent_healthcare.py / agent_github.py's output is.
# SLACK_BOT_TOKEN is a bot token (starts with "xoxb-") from a Slack app
# installed to your workspace, with at least channels:history,
# channels:read, and users:read scopes (add groups:history/groups:read too
# for a private channel). Create one at api.slack.com/apps.
# SLACK_CHANNEL is either a channel ID (e.g. C0123456789) or a name
# starting with "#" (e.g. #general) — the bot must already be a member of
# it (invite it with /invite @your-bot-name in that channel).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# For agent_gmail.py — the real Gmail connector. NOTE: same as Slack above
# — NO fabrication/content-verification guardrail wired in yet (see
# agent_gmail.py's module docstring). Don't treat its output as
# trustworthy the way agent_healthcare.py / agent_github.py's output is.
# GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET come from an OAuth 2.0 Client ID
# (type "Desktop app") created in Google Cloud Console after enabling the
# Gmail API. GMAIL_REFRESH_TOKEN is a one-time token for the specific
# inbox you want read — get it via Google's OAuth Playground
# (developers.google.com/oauthplayground): use your own OAuth credentials,
# authorize scope https://www.googleapis.com/auth/gmail.readonly signed in
# as that inbox, then exchange the auth code for tokens and copy the
# refresh token shown. Full walkthrough in connectors_gmail.py's docstring.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# For rag_index.py — the local RAG knowledge base (Chroma, stored on disk
# at ./rag_store/) behind the search_knowledge_base tool every connector
# agent has, and studio.py's Search page (GET /rag/search). This is a
# SEPARATE credential from ANTHROPIC_API_KEY above — embeddings go through
# Amazon Bedrock (Titan Text Embeddings V2), not Anthropic or OpenAI.
# AWS_BEARER_TOKEN_BEDROCK is one of Bedrock's own "long-term API keys" (a
# bearer token, not an access-key/secret-key pair) — generate one at
# Amazon Bedrock console -> API keys -> Long-term API keys -> Generate
# long-term API keys. Leaving this blank just means the "Sync knowledge
# base" section on the Integrations page and the Search page both explain
# it's not set up yet — every other feature works without it.
AWS_BEARER_TOKEN_BEDROCK=
# Optional, defaults to us-east-1 (N. Virginia) — set this if your Bedrock
# API key / model access was set up in a different AWS region.
BEDROCK_REGION=

# For server.py — signs session cookies for the login system. Optional:
# if left blank, a random key is generated each time the server starts,
# which just means everyone's logged out on restart. Set a fixed value
# (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`) if
# you want sessions to survive a server restart.
FLASK_SECRET_KEY=
